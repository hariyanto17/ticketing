{
  "name": "kasir-ticket-backend",
  "version": "1.0.0",
  "description": "TypeScript POS Retail backend generated from API documentation",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --require ts-node/register --test src/tests/*.test.ts",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:db:push": "prisma db push",
    "seed": "ts-node prisma/seed.ts",
    "seed:uat": "ts-node prisma/uatSeed.ts",
    "seed:uat:reset": "ts-node prisma/uatSeed.ts --reset"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.0.1",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
